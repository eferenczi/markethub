# API settings (development-only defaults are built in; use strong values in production)
PORT=4000
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Production account email (password resets and team invitations).
# PLATFORM_SENDGRID_API_KEY=
# PLATFORM_SENDGRID_FROM_EMAIL=no-reply@yourdomain.com

# Optional database override. SQLite is the local default.
# DB_CLIENT=pg
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/markethub
# DB_SSL=true

# Optional platform billing. Do not commit live Stripe credentials.
# PLATFORM_STRIPE_SECRET=
# PLATFORM_STRIPE_WEBHOOK_SECRET=
